<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:property name="M_PI" value="3.1415926535897931" />

  <!-- RPLIDAR A1M8 sensor macro for Gazebo Fortress (Ignition 6) -->
  <xacro:macro name="laser_sensor" params="reference:=laser topic_name:=scan update_rate:=10 ray_count:=360 min_angle:=-3.14159265 max_angle:=3.14159265 min_range:=0.15 max_range:=12.0 noise_stddev:=0.01">
    <gazebo reference="${reference}">
      <sensor name="rplidar_a1" type="gpu_lidar">
        <topic>${topic_name}</topic>
        <ignition_frame_id>${reference}</ignition_frame_id>
        <update_rate>${update_rate}</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>${ray_count}</samples>
              <resolution>1</resolution>
              <min_angle>${min_angle}</min_angle>
              <max_angle>${max_angle}</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0.0</min_angle>
              <max_angle>0.0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>${min_range}</min>
            <max>${max_range}</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>${noise_stddev}</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Alias for laser_sensor -->
  <xacro:macro name="lidar_sensor" params="reference:=laser topic_name:=scan update_rate:=10 ray_count:=360 min_angle:=-3.14159265 max_angle:=3.14159265 min_range:=0.15 max_range:=12.0 noise_stddev:=0.01">
    <xacro:laser_sensor 
      reference="${reference}" 
      topic_name="${topic_name}" 
      update_rate="${update_rate}" 
      ray_count="${ray_count}" 
      min_angle="${min_angle}" 
      max_angle="${max_angle}" 
      min_range="${min_range}" 
      max_range="${max_range}" 
      noise_stddev="${noise_stddev}" 
    />
  </xacro:macro>

  <!-- Complete laser link + joint + sensor definition for RPLIDAR A1M8 -->
  <xacro:macro name="laser" params="*origin update_rate:=10 ray_count:=360 min_angle:=-3.14159265 max_angle:=3.14159265 min_range:=0.15 max_range:=12.0 frame_id:=laser topic_name:=scan noise_stddev:=0.01">
    <link name="${frame_id}">
      <visual>
        <origin xyz="0 0 -0.025" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.035" length="0.05"/>
        </geometry>
        <material name="laser_material">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 -0.025" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.035" length="0.05"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.17"/>
        <inertia ixx="${(2/5) * 0.17 * (0.035 * 0.035)}" ixy="0" ixz="0"
                 iyy="${(2/5) * 0.17 * (0.035 * 0.035)}" iyz="0"
                 izz="${(2/5) * 0.17 * (0.035 * 0.035)}" />
      </inertial>
    </link>

    <gazebo reference="${frame_id}">  
      <visual>  
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>  
          <diffuse>0.1 0.1 0.1 1.0</diffuse>  
          <specular>0.5 0.5 0.5 1.0</specular>  
        </material>
      </visual> 
    </gazebo>

    <joint name="${frame_id}_to_base_link" type="fixed">
      <parent link="base_link"/>
      <child link="${frame_id}"/>
      <xacro:insert_block name="origin" />
    </joint>

    <xacro:laser_sensor 
      reference="${frame_id}" 
      topic_name="${topic_name}" 
      update_rate="${update_rate}" 
      ray_count="${ray_count}" 
      min_angle="${min_angle}" 
      max_angle="${max_angle}" 
      min_range="${min_range}" 
      max_range="${max_range}" 
      noise_stddev="${noise_stddev}" 
    />
  </xacro:macro>
</robot>
